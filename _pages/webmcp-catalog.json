---
layout: null
permalink: /webmcp-catalog.json
sitemap: false
---
{
  "site": {{ "/" | absolute_url | jsonify }},
  "logbook_home": "https://logbook.rocks/logbook/",
  "notes": [
    {%- assign items = site.blog | where: "note_kind", "personal" | sort: "date" | reverse -%}
    {%- for post in items %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "description": {{ post.description | default: "" | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "note_kind": "personal"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor %}
  ],
  "tech": [
    {%- assign items = site.blog | where: "note_kind", "technical" | sort: "date" | reverse -%}
    {%- for post in items %}
    {
      "title": {{ post.title | jsonify }},
      "url": {{ post.url | jsonify }},
      "date": {{ post.date | date: "%Y-%m-%d" | jsonify }},
      "description": {{ post.description | default: "" | jsonify }},
      "tags": {{ post.tags | jsonify }},
      "note_kind": "technical"
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor %}
  ]
}
